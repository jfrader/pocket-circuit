static func get_holdout_seeds(_room: String, _tier: String) -> Array[int]:
	# Same 200-seed list for every cell (per-cell variety is measured independently).
	# List is sorted for reproducible block splits.
	return SEEDS.duplicate()

static func get_holdout_blocks() -> Array[Array]:
	# Return four disjoint 48-seed blocks (sorted) + one remainder of 8.
	# Caller uses these to apply per-block floors.
	var seeds := SEEDS.duplicate()
	var blocks: Array[Array] = []
	for i in 4:
		blocks.append(seeds.slice(i*48, (i+1)*48))
	var remainder := seeds.slice(192, 200)
	blocks.append(remainder)
	return blocks
